<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>FancyText.Core</RootNamespace>
    <AssemblyName>FancyText.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FancyText.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 官方样式包：Resources/bundled/*.json 嵌为程序集资源（StylePacks.LoadBundled 枚举；目录暂缺不报错） -->
    <EmbeddedResource Include="Resources\bundled\*.json" />
    <EmbeddedResource Include="Resources\spark-simple.json" />
    <EmbeddedResource Include="Resources\opencc-st.txt.gz" />
    <EmbeddedResource Include="Resources\opencc-ts.txt.gz" />
    <EmbeddedResource Include="Resources\pinyin.txt.gz" />
  </ItemGroup>

</Project>
